# Copy to backend/.env for local backend startup. Never commit backend/.env.
MEDICORE_DB_URL=jdbc:postgresql://localhost:5432/medicore
MEDICORE_DB_USERNAME=medicore
MEDICORE_DB_PASSWORD=replace-local-db-password

# Generate distinct local values; each must be 32 bytes or longer.
MEDICORE_CRYPTO_ENCRYPTION_KEY=replace-with-64-hex-characters
MEDICORE_CRYPTO_COMPARISON_KEY=replace-with-64-hex-characters

# HMAC key for opaque sessions, CSRF, OTP, and reset tokens. Not JWT signing key.
MEDICORE_AUTH_SECRET_HASH_KEY=replace-with-a-unique-random-secret-at-least-32-bytes

MEDICORE_MAIL_HOST=smtp.example.test
MEDICORE_MAIL_PORT=587
MEDICORE_MAIL_USERNAME=replace-local-mail-username
MEDICORE_MAIL_PASSWORD=replace-local-mail-password
