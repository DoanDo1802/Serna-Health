NEXT_PUBLIC_APP_NAME="MediCore Patient Portal"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Same-origin BFF route. Leave unchanged unless deploying behind another same-origin route.
NEXT_PUBLIC_API_URL="/api/backend"
# Server-only backend origin used by app/api/backend/[...path]/route.ts.
MEDICORE_API_ORIGIN="http://localhost:8080"
MEDICORE_SESSION_COOKIE_PREFIX="MEDICORE_SESSION_"
# Local/test only. Backend still requires payment.mock.simulate and medicore.payment.mock-enabled=true.
NEXT_PUBLIC_ENABLE_MOCK_PAYMENT="false"
