{
  "name": "@medicore/staff-portal",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "MediCore Staff Portal — receptionist, doctor, cashier, queue coordinator",
  "engines": {
    "node": "24.18.1",
    "npm": "11.16.0"
