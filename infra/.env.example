MEDICORE_DB_NAME=medicore
MEDICORE_DB_USERNAME=medicore
MEDICORE_DB_PASSWORD=medicore-local-only
MEDICORE_DB_PORT=5432

# Backend HMAC key for opaque sessions, CSRF, OTP, and one-time reset tokens.
# Generate unique random value with at least 32 bytes. Never use this placeholder.
MEDICORE_AUTH_SECRET_HASH_KEY=replace-with-a-unique-random-secret-at-least-32-bytes
